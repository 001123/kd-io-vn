---
// Root index page handles client-side redirection to preferred locale
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD Lab • Google Play Developer</title>
    
    <!-- Fallback meta refresh if JS is disabled -->
    <meta http-equiv="refresh" content="0;url=/vi/" />
    
    <!-- Smart browser language detection -->
    <script is:inline>
      (function() {
        try {
          const savedLang = localStorage.getItem('kd_lang');
          if (savedLang === 'vi') {
            window.location.replace('/vi/');
            return;
          } else if (savedLang === 'en') {
            window.location.replace('/en/');
            return;
          }

          const browserLang = (navigator.language || navigator.userLanguage || '').toLowerCase();
          if (browserLang.startsWith('vi')) {
            window.location.replace('/vi/');
          } else {
            window.location.replace('/en/');
          }
        } catch (e) {
          window.location.replace('/vi/');
        }
      })();
    </script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: #FBF9F5;
        color: #1C1917;
      }
      .redirect-box {
        text-align: center;
        padding: 2rem;
      }
      a {
        color: #EA580C;
        text-decoration: underline;
        font-weight: 600;
        margin: 0 0.5rem;
      }
    </style>
  </head>
  <body>
    <div class="redirect-box">
      <h2>KD Lab</h2>
      <p>Đang chuyển hướng / Redirecting...</p>
      <p>
        <a href="/vi/">Tiếng Việt</a> | <a href="/en/">English</a>
      </p>
    </div>
  </body>
</html>
