---
// Root index page handles client-side redirection to preferred locale
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KD Labs • Google Play Developer</title>
    
    <!-- Fallback meta refresh if JS is disabled -->
    <meta http-equiv="refresh" content="0;url=/vi/" />
    
    <!-- Smart browser language detection -->
    <script is:inline>
      (function() {
        try {
          // 1. Explicit query parameter override (?lang=vi or ?lang=en)
          var params = new URLSearchParams(window.location.search);
          var paramLang = params.get('lang');
          if (paramLang === 'vi' || paramLang === 'en') {
            try { localStorage.setItem('kd_lang', paramLang); } catch (e) {}
            window.location.replace('/' + paramLang + '/');
            return;
          }

          // 2. Comprehensive browser language detection
          // Checks navigator.languages (array), navigator.language, legacy browser properties, and Intl API
          var langs = [];
          if (Array.isArray(navigator.languages)) {
            for (var i = 0; i < navigator.languages.length; i++) {
              if (navigator.languages[i]) {
                langs.push(String(navigator.languages[i]).toLowerCase());
              }
            }
          }
          if (navigator.language) {
            langs.push(String(navigator.language).toLowerCase());
          }
          if (navigator.userLanguage) {
            langs.push(String(navigator.userLanguage).toLowerCase());
          }
          if (navigator.browserLanguage) {
            langs.push(String(navigator.browserLanguage).toLowerCase());
          }
          try {
            var intl = Intl.DateTimeFormat().resolvedOptions().locale;
            if (intl) {
              langs.push(String(intl).toLowerCase());
            }
          } catch (e) {}

          // Check if Vietnamese is present in user's preferred languages
          var hasVietnamese = langs.some(function(l) {
            return l === 'vi' || l.indexOf('vi-') === 0 || l.indexOf('vi_') === 0;
          });

          if (hasVietnamese) {
            try { localStorage.setItem('kd_lang', 'vi'); } catch (e) {}
            window.location.replace('/vi/');
            return;
          }

          // 3. If browser does not have Vietnamese, check stored preference
          var savedLang = null;
          try { savedLang = localStorage.getItem('kd_lang'); } catch (e) {}
          if (savedLang === 'vi') {
            window.location.replace('/vi/');
            return;
          }

          // 4. Default for non-Vietnamese visitors
          window.location.replace('/en/');
        } catch (e) {
          window.location.replace('/vi/');
        }
      })();
    </script>
    <style>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        margin: 0;
        background: #FBF9F5;
        color: #1C1917;
      }
      .redirect-box {
        text-align: center;
        padding: 2rem;
      }
      a {
        color: #EA580C;
        text-decoration: underline;
        font-weight: 600;
        margin: 0 0.5rem;
      }
    </style>
  </head>
  <body>
    <div class="redirect-box">
      <h2>KD Labs</h2>
      <p>Đang chuyển hướng / Redirecting...</p>
      <p>
        <a href="/vi/">Tiếng Việt</a> | <a href="/en/">English</a>
      </p>
    </div>
  </body>
</html>
