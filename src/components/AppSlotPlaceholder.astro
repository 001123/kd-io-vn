---
import type { AppItem } from '../data/apps';
import type { Locale } from '../data/i18n';
import { getTranslations } from '../data/i18n';

interface Props {
  slot: AppItem;
  currentLang: Locale;
}

const { slot, currentLang } = Astro.props;
const t = getTranslations(currentLang);

const statusLabels = {
  in_development: {
    badge: t.showcase.inLabBadge,
    colorClass: 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/30',
    dotClass: 'bg-amber-500',
  },
  beta: {
    badge: t.showcase.comingSoonBadge,
    colorClass: 'bg-orange-500/10 text-orange-600 dark:text-orange-400 border-orange-500/30',
    dotClass: 'bg-orange-500',
  },
  slot_available: {
    badge: t.showcase.readySlotBadge,
    colorClass: 'bg-stone-500/10 text-stone-600 dark:text-stone-400 border-stone-500/30',
    dotClass: 'bg-stone-400',
  },
};

const currentStatus = statusLabels[slot.status as keyof typeof statusLabels] || statusLabels.slot_available;
---

<div class="relative rounded-3xl border-2 border-dashed border-stone-300 dark:border-stone-800 bg-stone-50/50 dark:bg-[#141210]/60 p-6 sm:p-7 flex flex-col justify-between hover:border-orange-500/60 transition-colors duration-200 group">
  
  <div class="space-y-4">
    <!-- Top Status Badge -->
    <div class="flex items-center justify-between">
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ${currentStatus.colorClass}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${currentStatus.dotClass}`}></span>
        {currentStatus.badge}
      </span>

      <span class="text-xs font-mono text-stone-600 dark:text-stone-300">
        {slot.version || 'v1.0.0'}
      </span>
    </div>

    <!-- Title and Category -->
    <div>
      <div class="text-xs uppercase tracking-wider font-semibold text-stone-600 dark:text-stone-300 mb-1">
        {slot.category[currentLang]}
      </div>
      <h4 class="text-xl font-bold text-stone-900 dark:text-stone-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
        {slot.name}
      </h4>
    </div>

    <!-- Description -->
    <p class="text-sm text-stone-600 dark:text-stone-300 leading-relaxed font-normal">
      {slot.shortDescription[currentLang]}
    </p>

    <!-- Features -->
    <ul class="space-y-1.5 text-xs text-stone-600 dark:text-stone-300 pt-1">
      {slot.features[currentLang].map((feature) => (
        <li class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 text-stone-400 dark:text-stone-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Bottom Slot Guide -->
  <div class="mt-6 pt-4 border-t border-dashed border-stone-200 dark:border-stone-800 flex items-center justify-between text-xs text-stone-600 dark:text-stone-300">
    <span class="flex items-center gap-1.5">
      <svg class="w-4 h-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
      </svg>
      <span>src/data/apps.ts</span>
    </span>

    <span class="font-medium text-stone-700 dark:text-stone-300">
      {currentLang === 'vi' ? 'Sẵn sàng kích hoạt' : 'Ready to deploy'}
    </span>
  </div>

</div>
